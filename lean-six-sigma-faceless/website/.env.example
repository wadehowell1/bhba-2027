# Copy to .env and fill in. .env is git-ignored and must never be committed.
# These values are read by the serverless function that handles form submissions —
# NOT by index.html. Nothing secret may appear in client-side code.

# Email service provider
ESP_PROVIDER=convertkit
ESP_API_KEY=your_api_key_here
ESP_FORM_ID=your_form_id_here

# Payments — hosted checkout only; we never handle card data
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder

# Analytics (privacy-friendly)
ANALYTICS_DOMAIN=example.com

# Site
SITE_URL=https://example.com
CONTACT_EMAIL=hello@example.com
