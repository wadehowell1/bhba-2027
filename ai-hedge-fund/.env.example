# ─── AI Hedge Fund — API credentials ────────────────────────────────
# Copy to .env and fill in.  .env is git-ignored. NEVER commit real keys.

# ── Market data (pick at least one; yfinance needs no key) ──
MARKET_DATA_PROVIDER=yfinance          # yfinance | alphavantage | fmp | finnhub
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=

# ── News ──
NEWS_PROVIDER=newsapi                  # newsapi | finnhub | none
NEWSAPI_API_KEY=

# ── SEC EDGAR ──
# EDGAR REQUIRES a descriptive User-Agent containing a real contact email,
# or it returns 403. Format: "Name your@email.com"
SEC_USER_AGENT=Your Name your@email.com

# ── Optional ──
CACHE_TTL_MINUTES=60
